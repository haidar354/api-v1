              "raw": "{\n  \"full_name\": \"Ms. Teacher Johnson\",\n  \"email\": \"teacher.johnson@school.edu\",\n  \"id_role\": 2,\n  \"data\": {\n    \"department\": \"Mathematics\",\n    \"employeeId\": \"TCH001\",\n    \"subjects\": [\"Algebra\", \"Geometry\"],\n    \"classroom\": \"Room 101\",\n    \"phone\": \"+62812345679\"\n  }\n}"
