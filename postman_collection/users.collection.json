              "raw": "{\n  \"full_name\": \"Student Alice Brown\",\n  \"email\": \"alice.brown@student.school.edu\",\n  \"id_role\": 3,\n  \"data\": {\n    \"grade\": \"10\",\n    \"class\": \"A\",\n    \"studentId\": \"2024001\",\n    \"parentName\": \"Mr. Brown\",\n    \"parentPhone\": \"+62812345680\",\n    \"address\": \"123 Student Street\"\n  }\n}"
