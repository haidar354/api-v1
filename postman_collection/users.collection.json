                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Admin User\",\n  \"email\": \"admin@school.edu\",\n  \"id_role\": 0,\n  \"data\": {\n    \"department\": \"Administration\",\n    \"employeeId\": \"ADM001\",\n    \"permissions\": [\"all\"]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/users",
