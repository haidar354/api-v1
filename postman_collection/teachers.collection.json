              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{LOCAL}}{{apiPrefix}}/teachers/stats/classes",
              "host": ["{{LOCAL}}"],
              "path": ["{{apiPrefix}}", "teachers", "stats", "classes"]
            },
            "description": "Get teacher count statistics grouped by class"
          },
          "response": []
        }
      ],
      "description": "Statistical endpoints for teacher analytics and reporting"
    },
