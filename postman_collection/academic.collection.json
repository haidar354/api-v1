	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set timestamp for requests",
					"pm.globals.set('timestamp', new Date().toISOString());",
					"",
					"// Check if auth_token is set",
					"if (!pm.globals.get('auth_token')) {",
					"    console.log('Warning: auth_token is not set. Please set the auth_token variable.');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Basic response validation",
					"pm.test('Response status code is valid', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 207, 400, 401, 403, 404, 500]);",
					"});",
					"",
					"// Check for authentication errors",
					"if (pm.response.code === 401) {",
					"    pm.test('Authentication required', function () {",
					"        console.log('Authentication failed. Please check your auth_token.');",
					"    });",
					"}",
					"",
					"// Check response format for successful requests",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"    pm.test('Response has data field', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('data');",
					"    });",
					"}",
					"",
					"// Check response format for error requests",
					"if (pm.response.code >= 400) {",
					"    pm.test('Error response has error field', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('error');",
					"    });",
					"}",
					"",
					"// Log response time",
					"pm.test('Response time is reasonable', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"// Log successful operations",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"    console.log('✅ Request successful:', pm.info.requestName);",
					"} else {",
					"    console.log('❌ Request failed:', pm.info.requestName, 'Status:', pm.response.code);",
					"}"
				]
			}
		}
