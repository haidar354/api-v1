{
  "info": {
    "name": "Website Sekolahku - Upload API",
    "description": "Complete API collection for file upload management endpoints in the school management system. Includes single file upload, multiple file upload with folder organization, and file management features.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "LOCAL",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Bearer token for authentication"
    }
  ],
  "item": [
    {
      "name": "File Upload",
      "item": [
        {
          "name": "Upload Single File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a file to upload"
                },
                {
                  "key": "folder_name",
                  "value": "documents",
                  "type": "text",
                  "description": "Optional folder name (max 20 characters)"
                }
              ]
            },
            "url": {
              "raw": "{{LOCAL}}{{apiPrefix}}/upload",
              "host": ["{{LOCAL}}"],
              "path": ["{{apiPrefix}}", "upload"]
            },
            "description": "Upload a single file to the server. File will be stored in /public or /public/{folder_name} if specified. File naming format: {folder_name}-{sub_folder}-{UUID}-{first25chars}.{ext}"
          },
          "response": []
        },
        {
          "name": "Upload Multiple Files",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Select multiple files to upload"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Additional file (you can add more files by duplicating this key)"
                },
                {
                  "key": "folder_name",
                  "value": "batch",
                  "type": "text",
                  "description": "Optional folder name for organizing files (max 20 characters)"
                }
              ]
            },
            "url": {
              "raw": "{{LOCAL}}{{apiPrefix}}/upload",
              "host": ["{{LOCAL}}"],
              "path": ["{{apiPrefix}}", "upload"]
            },
            "description": "Upload multiple files at once. All files will be organized in the same folder if folder_name is specified."
          },
          "response": []
        }
      ],
      "description": "File upload endpoints for single and multiple file uploads"
    },
