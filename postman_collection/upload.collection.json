        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set timestamp for requests",
          "pm.globals.set('timestamp', new Date().toISOString());",
          "",
          "// Check if auth_token is set",
          "if (!pm.collectionVariables.get('auth_token')) {",
          "    console.log('Warning: auth_token is not set. Please set the auth_token variable.');",
          "}",
          "",
          "// Log upload request info",
          "console.log('🔄 Preparing file upload request...');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Basic response validation",
          "pm.test('Response status code is valid', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 413, 415, 500]);",
          "});",
          "",
          "// Check for authentication errors",
          "if (pm.response.code === 401) {",
          "    pm.test('Authentication required', function () {",
          "        console.log('❌ Authentication failed. Please check your auth_token.');",
          "    });",
          "}",
          "",
          "// Check for file size errors",
          "if (pm.response.code === 413) {",
          "    pm.test('File too large', function () {",
          "        console.log('❌ File size exceeds server limits.');",
          "    });",
          "}",
          "",
          "// Check for unsupported file type",
          "if (pm.response.code === 415) {",
          "    pm.test('Unsupported file type', function () {",
          "        console.log('❌ File type not supported by server.');",
          "    });",
          "}",
          "",
          "// Check response format for successful uploads",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    pm.test('Upload successful - has message field', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('message');",
          "    });",
          "    ",
          "    pm.test('Upload successful - has uploaded_files array', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('uploaded_files');",
          "        pm.expect(jsonData.uploaded_files).to.be.an('array');",
          "    });",
          "    ",
          "    // Log uploaded files info",
          "    try {",
          "        const jsonData = pm.response.json();",
          "        if (jsonData.uploaded_files && jsonData.uploaded_files.length > 0) {",
          "            console.log('✅ Files uploaded successfully:');",
          "            jsonData.uploaded_files.forEach((file, index) => {",
          "                console.log(`   ${index + 1}. ${file.filename || file.name || 'Unknown'}`);",
          "            });",
          "        }",
          "    } catch (e) {",
          "        console.log('✅ Upload successful but could not parse file details');",
          "    }",
          "}",
          "",
          "// Check response format for error requests",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error response has error field', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('error');",
          "    });",
          "}",
          "",
          "// Log response time",
          "pm.test('Upload response time is reasonable', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(30000); // 30 seconds for file uploads",
          "});",
          "",
          "// Log operation result",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    console.log('✅ Upload request successful:', pm.info.requestName);",
          "} else {",
          "    console.log('❌ Upload request failed:', pm.info.requestName, 'Status:', pm.response.code);",
          "}"
        ]
      }
    }
  ]
