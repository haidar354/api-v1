                }
              ]
            },
            "description": "Example: Get all students in Class 1"
          },
          "response": []
        }
      ],
      "description": "Example requests for testing different student scenarios"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set timestamp for requests",
          "pm.globals.set('timestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Basic response validation",
          "pm.test('Response status code is valid', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 404, 500]);",
          "});",
          "",
          "// Check response format for success responses",
          "if (pm.response.code < 400) {",
          "    pm.test('Response has data or message', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.satisfy(function(data) {",
          "            return data.hasOwnProperty('data') || data.hasOwnProperty('message');",
          "        });",
          "    });",
          "}",
          "",
          "// Log response time",
          "pm.test('Response time is reasonable', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ]
}
