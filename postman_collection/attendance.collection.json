	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set current timestamp for visit_date if needed",
					"if (pm.request.body && pm.request.body.formdata) {",
					"    pm.request.body.formdata.forEach(function(item) {",
					"        if (item.key === 'visit_date' && item.value === '{{current_timestamp}}') {",
					"            const now = new Date();",
					"            now.setHours(now.getHours() + 1); // 1 hour from now",
					"            item.value = now.toISOString();",
					"        }",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Basic response validation",
					"pm.test('Response status code is valid', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 207]);",
					"});",
					"",
					"pm.test('Response has JSON body', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"});",
					"",
					"// Store auth token if login response",
					"if (pm.response.json() && pm.response.json().token) {",
					"    pm.environment.set('auth_token', pm.response.json().token);",
					"}"
				]
			}
		}
